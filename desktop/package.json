{
  "name": "@omnicode/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Omni Code — the transparent AI code editor",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --config electron-builder.json",
    "dist:linux": "electron-builder --config electron-builder.json --linux",
    "dist:mac": "electron-builder --config electron-builder.json --mac",
    "dist:win": "electron-builder --config electron-builder.json --win"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  }
}
